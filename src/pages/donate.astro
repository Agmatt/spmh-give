---
import LandingLayout from '../layout/LandingLayout.astro';
import MpesaTillCard from '../components/forms/MpesaTillCard.astro';
import BankTransferCard from '../components/forms/BankTransferCard.astro';
import DonationForm from '../components/forms/DonationForm.jsx';
import { sortedCampaigns } from '../data/campaigns';
import { site } from '../data/site';

// ... (keep jsonLd) ...
---

<LandingLayout ...>
  <!-- HERO (Keep existing) -->
  <section class='bg-cream border-b border-line'>
    <!-- ... -->
  </section>

  <!-- THE NEW DONATION FLOW -->
  <section class='bg-cream py-16 md:py-24'>
    <div class='container-prose'>
      <div class='max-w-2xl mx-auto'>
        <DonationForm campaigns={sortedCampaigns} client:load />
      </div>
    </div>
  </section>

  <!-- FALLBACK / OTHER METHODS -->
  <section class='bg-white py-16 md:py-24 border-t border-line'>
    <div class='container-prose'>
      <div class='text-center mb-10'>
        <p class='eyebrow-gold mb-4 justify-center'>Prefer to give directly?</p>
        <h2 class='display text-2xl md:text-3xl'>Give without a form.</h2>
      </div>

      <div class='grid md:grid-cols-2 gap-5 max-w-4xl mx-auto'>
        <MpesaTillCard />
        <BankTransferCard />
      </div>
    </div>
  </section>

  <!-- ... (Keep impact, trust, contact sections) ... -->
</LandingLayout>
