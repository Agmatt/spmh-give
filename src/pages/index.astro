---
import LandingLayout from '../layout/LandingLayout.astro';
import CampaignSpotlight from '../components/sections/CampaignSpotlight.astro';
import CampaignCard from '../components/sections/CampaignCard.astro';
import { sortedCampaigns, formatKes } from '../data/campaigns';
import {
  institutionalNumbers,
  impactTeasers,
  allocation,
  trustSignals,
} from '../data/impact';
import { site } from '../data/site';

const [featured, ...others] = sortedCampaigns;
---

<LandingLayout
  title='Give'
  description={`Give to ${site.name}. Help build the ICU, theatres, and diagnostics that 250,000 people in Homa Bay County depend on.`}>
  <!-- ============================================================
       HERO — editorial split. Type left, photograph right.
  ============================================================= -->
  <section class='relative bg-cream overflow-hidden'>
    <div class='container-prose'>
      <div
        class='grid lg:grid-cols-12 gap-10 lg:gap-16 items-center py-14 md:py-20 lg:py-24'>
        <!-- Type column -->
        <div class='lg:col-span-6 xl:col-span-5'>
          <p class='eyebrow-gold mb-8'>Homa Bay &middot; Kenya</p>

          <h1
            class='display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl mb-7 text-balance'>
            Some patients we<br class='hidden sm:block' />
            cannot save.<br />
            <span class='italic font-normal text-primary'>Not yet.</span>
          </h1>

          <p
            class='text-lg text-ink-soft leading-relaxed mb-6 max-w-xl text-pretty'>
            St. Paul&rsquo;s Mission Hospital serves a quarter of a million
            people across Homa Bay County. Every day our team does remarkable
            work with what we have.
          </p>

          <p
            class='text-lg text-ink-soft leading-relaxed mb-10 max-w-xl text-pretty'>
            But when a patient needs an ICU bed, modern surgery, or a diagnosis
            we can&rsquo;t give them here — we send them away. Too often, they
            don&rsquo;t make it back. With your help, that changes.
          </p>

          <div class='flex flex-wrap items-center gap-4'>
            <a href='/donate' class='btn-primary !px-7 !py-3.5 !text-base'>
              Give today
            </a>
            <a
              href='#campaigns'
              class='btn-ghost !text-base !px-0 !text-primary hover:!bg-transparent hover:underline'>
              See what we&rsquo;re building →
            </a>
          </div>
        </div>

        <!-- Image column -->
        <div class='lg:col-span-6 xl:col-span-7 relative'>
          <div
            class='relative aspect-[4/5] sm:aspect-[3/4] lg:aspect-[4/5] rounded-sm overflow-hidden bg-gradient-to-br from-secondary to-primary'>
            <img
              src='/img/10.jpg'
              alt="A clinician caring for a patient at St. Paul's Mission Hospital"
              class='w-full h-full object-cover'
              loading='eager'
              fetchpriority='high'
            />
          </div>

          <!-- Floating fact card -->
          <div
            class='hidden sm:block absolute -bottom-6 -left-6 lg:-left-12 bg-white border border-line p-6 shadow-[0_20px_60px_-20px_rgba(15,23,32,0.25)] max-w-[280px]'>
            <p
              class='font-mono text-3xl font-semibold text-accent leading-none mb-2'>
              0
            </p>
            <p class='text-sm font-semibold text-ink leading-snug mb-1'>
              ICU beds
            </p>
            <p class='text-xs text-ink-soft leading-relaxed'>
              for a catchment of 250,000 people. Every critical patient is
              referred out.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       REALITY STRIP — the numbers, editorial style
  ============================================================= -->
  <section class='bg-white border-y border-line'>
    <div class='container-prose'>
      <div
        class='grid grid-cols-2 lg:grid-cols-4 divide-x divide-line border-x border-line'>
        {
          institutionalNumbers.map((n) => (
            <div class='p-8 md:p-10'>
              <p
                class:list={[
                  'font-mono text-4xl md:text-5xl font-medium mb-4 leading-none tracking-tight',
                  n.value === '0' ? 'text-accent' : 'text-ink',
                ]}>
                {n.value}
              </p>
              <p class='text-[13px] font-semibold uppercase tracking-wider text-ink mb-2'>
                {n.label}
              </p>
              <p class='text-xs text-ink-soft leading-relaxed'>{n.context}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================
       CAMPAIGNS — spotlight + grid
  ============================================================= -->
  <section id='campaigns' class='bg-cream py-20 md:py-28'>
    <div class='container-prose'>
      <div class='grid lg:grid-cols-12 gap-8 mb-16 items-end'>
        <div class='lg:col-span-7'>
          <p class='eyebrow-gold mb-5'>The work ahead</p>
          <h2 class='display text-3xl md:text-5xl mb-6 text-balance'>
            Five things that would change everything.
          </h2>
        </div>
        <div class='lg:col-span-5'>
          <p class='text-base text-ink-soft leading-relaxed text-pretty'>
            Each of these closes a gap we feel every week — a mother, a child, a
            neighbour who needed something we couldn&rsquo;t give them here.
          </p>
        </div>
      </div>

      <!-- Featured campaign — full width, spotlight -->
      <CampaignSpotlight campaign={featured} />

      <!-- Others — restrained grid -->
      <div class='mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4'>
        {others.map((c) => <CampaignCard campaign={c} />)}
      </div>
    </div>
  </section>

  <!-- ============================================================
       IMPACT — menu-style with dotted leaders
  ============================================================= -->
  <section class='bg-white py-20 md:py-28'>
    <div class='container-prose'>
      <div class='grid lg:grid-cols-12 gap-12'>
        <!-- Left: header -->
        <div class='lg:col-span-5 lg:sticky lg:top-28 lg:self-start'>
          <p class='eyebrow-gold mb-5'>Your gift, in real terms</p>
          <h2 class='display text-3xl md:text-5xl mb-6 text-balance'>
            Every shilling has a name.
          </h2>
          <p class='text-base text-ink-soft leading-relaxed text-pretty mb-8'>
            Not vague promises. These are real services, real costs — the
            everyday work of a hospital that treats everyone who walks through
            its doors.
          </p>
          <a href='/donate' class='btn-primary'> Give a specific amount </a>
        </div>

        <!-- Right: menu -->
        <div class='lg:col-span-7'>
          <ul class='divide-y divide-line border-y border-line'>
            {
              impactTeasers.map((t) => (
                <li class='py-6 grid grid-cols-[auto_1fr] gap-x-6 items-baseline'>
                  <span class='font-mono text-xl md:text-2xl font-semibold text-primary whitespace-nowrap'>
                    {t.amount}
                  </span>
                  <span class='text-base text-ink leading-relaxed'>
                    {t.impact}
                  </span>
                </li>
              ))
            }
          </ul>
          <p class='text-xs text-ink-soft mt-6 leading-relaxed'>
            Monthly giving available at any amount. Choose your amount when you
            give.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       ACCOUNTABILITY — quiet, single column, editorial
  ============================================================= -->
  <section class='bg-secondary text-white py-20 md:py-28'>
    <div class='container-prose'>
      <div class='grid lg:grid-cols-12 gap-12 items-center'>
        <div class='lg:col-span-5'>
          <p class='eyebrow-gold mb-5 !text-gold'>Transparency</p>
          <h2
            class='font-display text-3xl md:text-4xl font-medium leading-[1.1] text-white mb-6 text-balance'
            style='letter-spacing: -0.025em;'>
            You have a right<br />
            to know exactly<br />
            where this goes.
          </h2>
          <p class='text-base text-white/70 leading-relaxed mb-8 text-pretty'>
            Kenya has seen real donation fraud. We take that seriously. Every
            gift is receipted, every shilling tracked, and our accounts audited
            and published annually.
          </p>
          <a
            href='/annual-reports'
            class='inline-flex items-center gap-2 text-gold font-semibold hover:gap-3 transition-all'>
            Read our reports
            <span aria-hidden='true'>→</span>
          </a>
        </div>

        <div class='lg:col-span-6 lg:col-start-7'>
          <ul class='space-y-8'>
            {
              allocation.map((a) => (
                <li>
                  <div class='flex items-baseline justify-between mb-3'>
                    <span class='text-sm font-semibold text-white/90 uppercase tracking-wider'>
                      {a.label}
                    </span>
                    <span class='font-mono text-2xl font-medium text-gold tabular-nums'>
                      {a.percentage}%
                    </span>
                  </div>
                  <div class='w-full h-px bg-white/15 relative overflow-hidden mb-3'>
                    <div
                      class='absolute inset-y-0 left-0 bg-gold'
                      style={`width: ${a.percentage}%`}
                    />
                  </div>
                  <p class='text-xs text-white/55 leading-relaxed max-w-lg'>
                    {a.description}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       TRUST — single pull quote + three proofs
  ============================================================= -->
  <section class='bg-white py-20 md:py-28'>
    <div class='container-prose'>
      <div class='max-w-3xl mx-auto text-center mb-20'>
        <p class='eyebrow-gold mb-6 justify-center'>Why SPMH</p>
        <blockquote
          class='font-display text-2xl md:text-4xl font-medium leading-[1.25] text-ink text-balance'
          style='letter-spacing: -0.02em;'>
          &ldquo;A faith-based hospital under the Catholic Diocese of Homa Bay.
          Care here is a <em class='not-italic text-primary'>calling</em>, not a
          transaction.&rdquo;
        </blockquote>
      </div>

      <div class='grid md:grid-cols-3 gap-px bg-line border border-line'>
        {
          trustSignals.map((s) => (
            <div class='bg-white p-8 md:p-10'>
              <div class='inline-flex items-center justify-center w-10 h-10 text-primary mb-6'>
                {s.icon === 'cross' && (
                  <svg
                    xmlns='http://www.w3.org/2000/svg'
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='1.5'
                    class='w-6 h-6'>
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M12 3v18M6 9h12'
                    />
                  </svg>
                )}
                {s.icon === 'eye' && (
                  <svg
                    xmlns='http://www.w3.org/2000/svg'
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='1.5'
                    class='w-6 h-6'>
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z'
                    />
                    <circle cx='12' cy='12' r='3' />
                  </svg>
                )}
                {s.icon === 'location' && (
                  <svg
                    xmlns='http://www.w3.org/2000/svg'
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='1.5'
                    class='w-6 h-6'>
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z'
                    />
                    <circle cx='12' cy='10' r='3' />
                  </svg>
                )}
              </div>
              <h3 class='font-display text-lg font-semibold mb-3 text-ink'>
                {s.title}
              </h3>
              <p class='text-sm text-ink-soft leading-relaxed'>
                {s.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================
       FINAL CTA — restrained
  ============================================================= -->
  <section class='bg-cream border-t border-line py-20 md:py-28'>
    <div class='container-prose'>
      <div class='max-w-3xl'>
        <p class='eyebrow-gold mb-6'>Give today</p>
        <h2 class='display text-3xl md:text-5xl mb-6 text-balance'>
          Help us become the hospital<br class='hidden md:block' />
          Homa Bay deserves.
        </h2>
        <p
          class='text-lg text-ink-soft leading-relaxed mb-10 max-w-2xl text-pretty'>
          Whether it&rsquo;s KES 500 or KES 500,000 — every gift closes a gap a
          patient feels today.
        </p>
        <div class='flex flex-wrap items-center gap-6'>
          <a href='/donate' class='btn-primary !px-7 !py-3.5 !text-base'>
            Give now
          </a>
          <a
            href='/contact-giving'
            class='text-primary font-semibold hover:underline underline-offset-4'>
            Talk to our giving team →
          </a>
        </div>

        <p class='text-xs text-ink-soft mt-14 max-w-lg leading-relaxed'>
          By donating, you agree to our
          <a href='/terms-of-giving' class='underline hover:text-ink'
            >Terms of Giving</a
          > and
          <a href='/privacy' class='underline hover:text-ink'>Privacy Policy</a
          >.
        </p>
      </div>
    </div>
  </section>
</LandingLayout>
