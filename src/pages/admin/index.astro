---
import AdminLayout from '../../layout/AdminLayout.astro';
---

<AdminLayout title='Overview'>
  <div class='grid md:grid-cols-3 gap-6'>
    <div class='bg-white border border-line p-6'>
      <p
        class='text-[11px] font-bold uppercase tracking-[0.18em] text-ink-soft mb-2'>
        Pending Donations
      </p>
      <p class='font-display text-4xl font-semibold text-primary'>—</p>
    </div>
    <div class='bg-white border border-line p-6'>
      <p
        class='text-[11px] font-bold uppercase tracking-[0.18em] text-ink-soft mb-2'>
        New Enquiries
      </p>
      <p class='font-display text-4xl font-semibold text-primary'>—</p>
    </div>
    <div class='bg-white border border-line p-6'>
      <p
        class='text-[11px] font-bold uppercase tracking-[0.18em] text-ink-soft mb-2'>
        Total Raised (This Month)
      </p>
      <p class='font-display text-4xl font-semibold text-primary'>—</p>
    </div>
  </div>
</AdminLayout>
