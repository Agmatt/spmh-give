---
import LandingLayout from '../layout/LandingLayout.astro';
import { site } from '../data/site';

const jsonLd = {
  '@type': 'WebPage',
  name: "Our Donors — St. Paul's Mission Hospital",
  description:
    "Recognising the people and partners who give to St. Paul's Mission Hospital — with explicit, revocable consent.",
  url: `${site.url}/donors`,
};

/** Entries from Supabase in Wave 7. Consent-first. Anonymous by default. */
const donors: { name: string; tier: string; note?: string }[] = [];
---

<LandingLayout
  title='Our Donors'
  description="Recognising the individuals, corporates, and institutions who give to St. Paul's Mission Hospital — with explicit consent."
  canonical='/donors'
  jsonLd={jsonLd}>
  <!-- ============================================================
       HERO — the policy is the story
  ============================================================= -->
  <section class='bg-cream border-b border-line'>
    <div class='container-prose py-16 md:py-24'>
      <div class='grid lg:grid-cols-12 gap-10 lg:gap-16 items-end'>
        <div class='lg:col-span-7'>
          <p class='eyebrow-gold mb-6'>With gratitude</p>
          <h1 class='display text-4xl md:text-6xl mb-6 text-balance'>
            The people who make this possible.
          </h1>
          <p class='text-lg text-ink-soft leading-relaxed max-w-xl text-pretty'>
            Every gift to SPMH carries a name — or a deliberate choice to give
            without one. This page honours both.
          </p>
        </div>

        <div class='lg:col-span-5 lg:col-start-8'>
          <p
            class='text-sm text-ink-soft leading-relaxed border-l-2 border-primary pl-5'>
            Names appear here only with explicit, written consent. Giving
            anonymously is always an option. Consent can be revoked at any time,
            and we will remove your name within 48 hours.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       THE POLICY — consent, in detail
  ============================================================= -->
  <section class='bg-white py-16 md:py-24 border-b border-line'>
    <div class='container-prose'>
      <div class='max-w-2xl mb-12 md:mb-16'>
        <p class='eyebrow-gold mb-5'>Our recognition policy</p>
        <h2 class='display text-3xl md:text-5xl mb-5 text-balance'>
          Four rules we never break.
        </h2>
      </div>

      <ul class='grid sm:grid-cols-2 gap-px bg-line border border-line'>
        {
          [
            {
              n: '01',
              title: 'Consent, in writing',
              body: 'We publish a donor’s name only after receiving explicit, written consent. No exceptions, regardless of gift size.',
            },
            {
              n: '02',
              title: 'Anonymity is honoured',
              body: 'Many of our donors give quietly. That choice is respected without question, and without a hint that a name was withheld.',
            },
            {
              n: '03',
              title: 'Amounts are never published',
              body: 'We recognise that a gift was made. We never disclose how much.',
            },
            {
              n: '04',
              title: 'Revocable at any time',
              body: 'You can ask us to remove your name at any time. We act within 48 hours, no questions asked.',
            },
          ].map((p) => (
            <li class='bg-white p-8 md:p-10'>
              <p class='font-mono text-xs font-semibold text-primary mb-6 tabular-nums'>
                {p.n}
              </p>
              <h3 class='font-display text-lg font-semibold text-ink mb-3 leading-tight'>
                {p.title}
              </h3>
              <p class='text-sm text-ink-soft leading-relaxed'>{p.body}</p>
            </li>
          ))
        }
      </ul>

      <p class='mt-10 text-xs text-ink-soft leading-relaxed max-w-2xl'>
        To update or revoke your recognition preference, email
        <a
          href={`mailto:${site.givingEmail}`}
          class='text-primary font-semibold underline underline-offset-2'>
          {site.givingEmail}
        </a>. Your request is handled by our Data Protection Officer.
      </p>
    </div>
  </section>

  <!-- ============================================================
       THE WALL — coming soon, honest
  ============================================================= -->
  <section class='bg-secondary text-white py-16 md:py-24'>
    <div class='container-prose'>
      <div class='grid lg:grid-cols-12 gap-10 mb-12 md:mb-16 items-end'>
        <div class='lg:col-span-7'>
          <p class='eyebrow-gold !text-gold mb-5'>Wall of donors</p>
          <h2
            class='font-display text-3xl md:text-5xl font-medium text-white leading-[1.05] mb-5 text-balance'
            style='letter-spacing: -0.025em;'>
            {donors.length > 0 ? 'Thank you.' : 'Opening soon.'}
          </h2>
        </div>
        <div class='lg:col-span-5'>
          <p class='text-base text-white/70 leading-relaxed text-pretty'>
            {
              donors.length > 0
                ? 'These are the people and partners who have chosen to be named. Every one of them gave with their full consent.'
                : 'The wall is opening as donors give consent to be recognised. When it launches, every name here will be here because that donor chose to be.'
            }
          </p>
        </div>
      </div>

      {
        donors.length === 0 ? (
          <div class='bg-white/[0.04] border border-white/10 p-10 md:p-16 text-center'>
            <p
              class='font-display text-xl md:text-2xl text-white/60 max-w-xl mx-auto leading-relaxed text-balance'
              style='letter-spacing: -0.015em;'>
              Nothing to show yet — and that&rsquo;s how we like it.
              <br class='hidden md:block' />
              <span class='text-white/40 text-base md:text-lg'>
                We would rather start with an empty wall than fill it with names
                we didn&rsquo;t have permission to publish.
              </span>
            </p>
          </div>
        ) : (
          <div class='grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-white/10 border border-white/10'>
            {donors.map((d) => (
              <div class='bg-secondary p-6 md:p-8'>
                <p class='font-display text-lg font-semibold text-white mb-2'>
                  {d.name}
                </p>
                <p class='text-xs uppercase tracking-wider text-gold mb-2'>
                  {d.tier}
                </p>
                {d.note && (
                  <p class='text-sm text-white/60 leading-relaxed'>{d.note}</p>
                )}
              </div>
            ))}
          </div>
        )
      }

      <div class='mt-12 flex flex-wrap items-center gap-x-8 gap-y-4'>
        <a
          href='/donate'
          class='btn-primary !bg-gold !text-secondary hover:!bg-white'>
          Join our donors
        </a>
        <a
          href='/how-it-helps'
          class='text-gold font-semibold hover:underline underline-offset-4'>
          See where gifts go →
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       WHY CONSENT MATTERS — quiet close
  ============================================================= -->
  <section class='bg-cream py-16 md:py-24'>
    <div class='container-prose'>
      <div class='max-w-3xl mx-auto text-center'>
        <p class='eyebrow-gold mb-6 justify-center'>Why this matters</p>
        <blockquote
          class='font-display text-2xl md:text-4xl font-medium leading-[1.25] text-ink text-balance'
          style='letter-spacing: -0.02em;'>
          &ldquo;The way we treat your name is the way we treat your gift —
          <em class='not-italic text-primary'
            >carefully, honestly, with consent.</em
          >&rdquo;
        </blockquote>
        <p class='text-sm text-ink-soft mt-8'>
          Questions about recognition? Email
          <a
            href={`mailto:${site.givingEmail}`}
            class='text-primary font-semibold underline underline-offset-2'>
            {site.givingEmail}
          </a>.
        </p>
      </div>
    </div>
  </section>
</LandingLayout>
