---
import LandingLayout from '../layout/LandingLayout.astro';
import { site } from '../data/site';

const jsonLd = {
  '@type': 'WebPage',
  name: "Corporate Giving — St. Paul's Mission Hospital",
  description:
    "Align your company's CSR with a hospital serving 250,000 people in Homa Bay County, Kenya.",
  url: `${site.url}/corporate`,
};

const tiers = [
  {
    name: 'Supporting Partner',
    range: 'KES 100,000 – 499,999',
    items: [
      'Recognition on the corporate partners page',
      'Annual impact briefing',
      'KRA-compliant receipt',
    ],
    featured: false,
  },
  {
    name: 'Strategic Partner',
    range: 'KES 500,000 – 2,999,999',
    items: [
      'Named recognition on a specific campaign',
      'Site visit and project briefing',
      'Co-branded CSR reporting',
      'Annual impact briefing',
    ],
    featured: true,
  },
  {
    name: 'Principal Partner',
    range: 'KES 3,000,000+',
    items: [
      'Naming rights on a project (by agreement)',
      'Board-level engagement',
      'Custom MOU and reporting framework',
      'Staff engagement and site visits',
    ],
    featured: false,
  },
];
---

<LandingLayout
  title='Corporate Giving'
  description="Corporate partnership and CSR alignment with St. Paul's Mission Hospital, Homa Bay."
  canonical='/corporate'
  jsonLd={jsonLd}>
  <!-- ============================================================
       BEAT 1 — HERO. Split layout.
  ============================================================= -->
  <section class='bg-cream border-b border-line'>
    <div class='grid lg:grid-cols-2'>
      <div class='flex items-center'>
        <div
          class='w-full px-6 md:px-10 lg:px-16 xl:px-24 py-16 md:py-24 lg:py-32'>
          <p class='eyebrow-gold mb-6'>Corporate partnership</p>
          <h1
            class='display text-4xl md:text-5xl lg:text-6xl mb-6 text-balance'>
            Align your company with a hospital that changes lives every day.
          </h1>
          <p
            class='text-lg text-ink-soft leading-relaxed mb-8 max-w-xl text-pretty'>
            SPMH serves 250,000 people across Homa Bay County. Your
            company&rsquo;s CSR can fund a documented, verifiable, high-impact
            health initiative — with reporting your board can stand behind.
          </p>

          <div class='flex flex-wrap items-center gap-x-8 gap-y-4'>
            <a
              href={`mailto:${site.givingEmail}?subject=Corporate partnership enquiry`}
              class='btn-primary !px-7 !py-3.5 !text-base'>
              Start a conversation
            </a>
            <a
              href='#tiers'
              class='text-primary font-semibold hover:underline underline-offset-4'>
              See partnership tiers →
            </a>
          </div>
        </div>
      </div>

      <div
        class='relative min-h-[320px] sm:min-h-[420px] lg:min-h-[640px] bg-gradient-to-br from-secondary to-primary'>
        <img
          src='/img/34.jpg'
          alt="Corporate partners visiting St. Paul's Mission Hospital"
          class='absolute inset-0 w-full h-full object-cover'
          loading='lazy'
        />
      </div>
    </div>
  </section>

  <!-- ============================================================
       BEAT 2 — WHY SPMH. Three proofs.
  ============================================================= -->
  <section class='bg-white py-16 md:py-24 border-b border-line'>
    <div class='container-prose'>
      <div class='max-w-2xl mb-12 md:mb-16'>
        <p class='eyebrow-gold mb-5'>Why SPMH</p>
        <h2 class='display text-3xl md:text-5xl mb-5 text-balance'>
          What makes a good corporate partner.
        </h2>
      </div>

      <ul class='grid md:grid-cols-3 gap-px bg-line border border-line'>
        {
          [
            {
              n: '01',
              title: 'Verifiable impact',
              body: 'Every partnership is reported against agreed metrics — patients served, equipment commissioned, staff trained.',
            },
            {
              n: '02',
              title: 'CSR alignment',
              body: 'Direct line to SDG 3 (good health), SDG 5 (maternal health), and Kenya Vision 2030 health goals.',
            },
            {
              n: '03',
              title: 'Recognised giving',
              body: 'Named recognition on the hospital site and our donor wall — always with your written consent.',
            },
          ].map((p) => (
            <li class='bg-white p-8 md:p-10'>
              <p class='font-mono text-xs font-semibold text-primary mb-6 tabular-nums'>
                {p.n}
              </p>
              <h3 class='font-display text-lg font-semibold text-ink mb-3 leading-tight'>
                {p.title}
              </h3>
              <p class='text-sm text-ink-soft leading-relaxed'>{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============================================================
       BEAT 3 — TIERS
  ============================================================= -->
  <section id='tiers' class='bg-cream py-16 md:py-24'>
    <div class='container-prose'>
      <div class='grid lg:grid-cols-12 gap-8 mb-12 md:mb-16 items-end'>
        <div class='lg:col-span-7'>
          <p class='eyebrow-gold mb-5'>Partnership levels</p>
          <h2 class='display text-3xl md:text-5xl mb-5 text-balance'>
            Ways to partner.
          </h2>
        </div>
        <div class='lg:col-span-5'>
          <p class='text-base text-ink-soft leading-relaxed text-pretty'>
            Every partnership is a signed MOU with agreed deliverables,
            reporting cadence, and recognition. Nothing is implicit.
          </p>
        </div>
      </div>

      <div class='grid md:grid-cols-3 gap-5 md:gap-6'>
        {
          tiers.map((t) => (
            <div
              class:list={[
                'relative flex flex-col p-8 md:p-10',
                t.featured
                  ? 'bg-secondary text-white border-2 border-primary'
                  : 'bg-white border border-line',
              ]}>
              {t.featured && (
                <span class='absolute -top-3 left-8 inline-block px-3 py-1 text-[10px] font-bold uppercase tracking-[0.18em] bg-primary text-white'>
                  Most common
                </span>
              )}

              <h3
                class:list={[
                  'font-display text-xl font-semibold mb-2 leading-tight',
                  t.featured ? 'text-white' : 'text-ink',
                ]}>
                {t.name}
              </h3>
              <p
                class:list={[
                  'font-mono text-sm mb-8 tabular-nums',
                  t.featured ? 'text-gold' : 'text-primary',
                ]}>
                {t.range}
              </p>

              <ul
                class:list={[
                  'space-y-3 text-sm leading-relaxed mb-8 flex-1',
                  t.featured ? 'text-white/85' : 'text-ink-soft',
                ]}>
                {t.items.map((item) => (
                  <li class='flex items-start gap-3'>
                    <span
                      class:list={[
                        'shrink-0 mt-2 w-3 h-px',
                        t.featured ? 'bg-gold' : 'bg-primary',
                      ]}
                    />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <a
                href={`mailto:${site.givingEmail}?subject=Corporate partnership enquiry — ${encodeURIComponent(t.name)}`}
                class:list={[
                  'inline-flex items-center justify-center gap-2 px-5 py-2.5 font-semibold text-sm transition-colors duration-300',
                  t.featured
                    ? 'bg-gold text-secondary hover:bg-white'
                    : 'border-2 border-primary text-primary hover:bg-primary hover:text-white',
                ]}>
                Discuss {t.name.split(' ')[0]}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================
       BEAT 4 — PROCESS
  ============================================================= -->
  <section class='bg-white py-16 md:py-24 border-t border-line'>
    <div class='container-prose'>
      <div class='grid lg:grid-cols-12 gap-10 lg:gap-16 items-start'>
        <div class='lg:col-span-5'>
          <p class='eyebrow-gold mb-5'>The process</p>
          <h2 class='display text-3xl md:text-4xl mb-6 text-balance'>
            How partnership works.
          </h2>
          <p class='text-base text-ink-soft leading-relaxed text-pretty'>
            From first conversation to signed MOU takes about four to six weeks.
            We move at the pace your board needs.
          </p>
        </div>

        <div class='lg:col-span-6 lg:col-start-7'>
          <ol class='space-y-8'>
            {
              [
                {
                  t: 'Enquiry',
                  d: 'Reach out via email with a short note about your CSR priorities.',
                },
                {
                  t: 'Scoping call',
                  d: 'We identify the campaign or programme best aligned with your focus.',
                },
                {
                  t: 'MOU',
                  d: 'A signed MOU sets scope, reporting cadence, and recognition.',
                },
                {
                  t: 'Delivery & reporting',
                  d: 'Funds are deployed against the agreed scope; you receive periodic impact reports.',
                },
              ].map((s, i) => (
                <li class='flex gap-6'>
                  <span class='shrink-0 w-10 h-10 flex items-center justify-center font-mono text-sm font-semibold text-primary border border-line bg-surface tabular-nums'>
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div class='pt-2'>
                    <h3 class='font-display text-lg font-semibold text-ink mb-2'>
                      {s.t}
                    </h3>
                    <p class='text-sm text-ink-soft leading-relaxed'>{s.d}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       BEAT 5 — CTA
  ============================================================= -->
  <section class='bg-secondary text-white py-16 md:py-24'>
    <div class='container-prose'>
      <div class='max-w-3xl'>
        <p class='eyebrow-gold !text-gold mb-6'>Let&rsquo;s talk</p>
        <h2
          class='font-display text-3xl md:text-5xl font-medium text-white leading-[1.05] mb-6 text-balance'
          style='letter-spacing: -0.025em;'>
          If your company is looking for a partner whose impact you can stand
          behind.
        </h2>
        <p
          class='text-lg text-white/75 leading-relaxed mb-10 max-w-2xl text-pretty'>
          We&rsquo;ll send you our partnership prospectus, current campaign
          priorities, and the reporting framework we use with corporate
          partners.
        </p>
        <div class='flex flex-wrap items-center gap-6'>
          <a
            href={`mailto:${site.givingEmail}?subject=Corporate partnership enquiry`}
            class='btn-primary !bg-gold !text-secondary hover:!bg-white !px-7 !py-3.5 !text-base'>
            Email the giving team
          </a>
          <a
            href='/campaigns'
            class='text-gold font-semibold hover:underline underline-offset-4'>
            See active campaigns →
          </a>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
