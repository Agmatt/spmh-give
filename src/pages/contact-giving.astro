---
import LandingLayout from '../layout/LandingLayout.astro';
import { site } from '../data/site';

const jsonLd = {
  '@type': 'ContactPage',
  name: "Contact Giving — St. Paul's Mission Hospital",
  description:
    'Contact the SPMH giving team for major gifts, legacy bequests, corporate partnerships, or general donation enquiries.',
  url: `${site.url}/contact-giving`,
};

const topics = [
  'General giving enquiry',
  'Major gift',
  'Legacy bequest',
  'Corporate partnership',
  'Diaspora giving',
  'Receipting',
  'Other',
];
---

<LandingLayout
  title='Contact Giving'
  description='Contact the SPMH giving team for major gifts, legacy bequests, corporate partnerships, or general donation enquiries.'
  canonical='/contact-giving'
  jsonLd={jsonLd}>
  <!-- HERO -->
  <section class='bg-cream border-b border-line'>
    <div class='container-prose py-16 md:py-24'>
      <div class='grid lg:grid-cols-12 gap-10 lg:gap-16 items-end'>
        <div class='lg:col-span-7'>
          <p class='eyebrow-gold mb-6'>Get in touch</p>
          <h1 class='display text-4xl md:text-6xl mb-6 text-balance'>
            Talk to the giving team.
          </h1>
          <p class='text-lg text-ink-soft leading-relaxed max-w-xl text-pretty'>
            For major gifts, legacy bequests, corporate partnerships, or any
            question about giving to SPMH — we&rsquo;re one message away.
          </p>
        </div>
        <div class='lg:col-span-5 lg:col-start-8'>
          <p
            class='text-sm text-ink-soft leading-relaxed border-l-2 border-primary pl-5'>
            We respond within two working days. For urgent matters, email
            <a
              href={`mailto:${site.givingEmail}`}
              class='text-primary font-semibold underline underline-offset-2 break-all'>
              {site.givingEmail}
            </a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- THREE CONTACT CARDS -->
  <section class='bg-white py-16 md:py-20 border-b border-line'>
    <div class='container-prose'>
      <ul class='grid md:grid-cols-3 gap-px bg-line border border-line'>
        <li class='bg-white p-8 md:p-10 flex flex-col'>
          <p
            class='text-[11px] font-bold uppercase tracking-[0.18em] text-accent mb-4'>
            General giving
          </p>
          <h2
            class='font-display text-lg font-semibold text-ink mb-2 leading-tight'>
            Giving team
          </h2>
          <p class='text-sm text-ink-soft leading-relaxed mb-6 flex-1'>
            One-off gifts, receipting, and general enquiries.
          </p>
          <a
            href={`mailto:${site.givingEmail}`}
            class='font-display text-base text-primary font-semibold hover:underline underline-offset-4 break-all'>
            {site.givingEmail}
          </a>
        </li>

        <li class='bg-white p-8 md:p-10 flex flex-col'>
          <p
            class='text-[11px] font-bold uppercase tracking-[0.18em] text-accent mb-4'>
            Major gifts &amp; legacy
          </p>
          <h2
            class='font-display text-lg font-semibold text-ink mb-2 leading-tight'>
            Fundraising lead
          </h2>
          <p class='text-sm text-ink-soft leading-relaxed mb-6 flex-1'>
            Gifts above KES 1M, planned giving, or legacy bequests.
          </p>
          <a
            href={`mailto:${site.givingEmail}?subject=Major gift enquiry`}
            class='font-display text-base text-primary font-semibold hover:underline underline-offset-4'>
            Start a conversation →
          </a>
        </li>

        <li class='bg-white p-8 md:p-10 flex flex-col'>
          <p
            class='text-[11px] font-bold uppercase tracking-[0.18em] text-accent mb-4'>
            Visit or write
          </p>
          <h2
            class='font-display text-lg font-semibold text-ink mb-2 leading-tight'>
            Our office
          </h2>
          <p class='text-sm text-ink-soft leading-relaxed mb-6 flex-1'>
            {site.legalName}<br />
            {site.address.physical}<br />
            {site.address.postal}
          </p>
          <a
            href={`mailto:${site.dpoEmail}?subject=Data protection enquiry`}
            class='text-xs text-ink-soft hover:text-primary underline underline-offset-4'>
            Data protection enquiries →
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- FORM WITH IMAGE + STEPS -->
  <section class='bg-cream py-16 md:py-24 border-b border-line'>
    <div class='container-prose'>
      <div class='grid lg:grid-cols-12 gap-10 lg:gap-16 items-start'>
        <div class='lg:col-span-5 lg:sticky lg:top-28'>
          <p class='eyebrow-gold mb-5'>Send us a message</p>
          <h2 class='display text-3xl md:text-4xl mb-6 text-balance'>
            Or write to us directly.
          </h2>

          <div
            class='relative aspect-[4/3] bg-gradient-to-br from-secondary to-primary overflow-hidden mb-8'>
            <img
              src='/gallery/2.jpg'
              alt="The giving team at St. Paul's Mission Hospital"
              class='absolute inset-0 w-full h-full object-cover'
              loading='lazy'
            />
          </div>

          <p
            class='text-[11px] font-bold uppercase tracking-[0.18em] text-ink-soft mb-4'>
            What happens next
          </p>
          <ol class='space-y-4 mb-8'>
            {
              [
                'Your message goes straight to the giving team inbox.',
                'We reply within two working days.',
                'If it needs a call or a meeting, we arrange it at your convenience.',
              ].map((step, i) => (
                <li class='flex items-start gap-4'>
                  <span class='shrink-0 w-6 h-6 flex items-center justify-center font-mono text-[11px] font-semibold text-primary border border-line bg-white tabular-nums'>
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class='text-sm text-ink-soft leading-relaxed pt-0.5'>
                    {step}
                  </span>
                </li>
              ))
            }
          </ol>

          <p
            class='text-xs text-ink-soft leading-relaxed border-t border-line pt-6'>
            By submitting the form, you agree to SPMH processing your details to
            respond to your enquiry, in line with our
            <a
              href='/privacy'
              class='text-primary font-semibold underline underline-offset-2'
              >Privacy Policy</a
            >. We never sell, rent, or share your information.
          </p>
        </div>

        <div class='lg:col-span-6 lg:col-start-7'>
          <!-- Success panel -->
          <div
            id='enquiry-success'
            hidden
            class='bg-white border border-line p-8 md:p-10'>
            <div
              class='inline-flex items-center justify-center w-12 h-12 bg-green-50 text-green-700 mb-6'>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                viewBox='0 0 20 20'
                fill='currentColor'
                class='w-6 h-6'>
                <path
                  fill-rule='evenodd'
                  d='M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z'
                  clip-rule='evenodd'></path>
              </svg>
            </div>
            <h3
              class='font-display text-2xl font-semibold text-ink mb-3 leading-tight'>
              Message received.
            </h3>
            <p class='text-base text-ink-soft leading-relaxed mb-6'>
              Thank you. Your enquiry is now in our giving team inbox.
              We&rsquo;ll reply within two working days.
            </p>
            <p class='text-base text-ink-soft leading-relaxed mb-6'>
              A confirmation email has been sent to your address.
            </p>
            <div class='border-t border-line pt-6'>
              <p
                class='text-[11px] font-bold uppercase tracking-[0.18em] text-ink-soft mb-2'>
                Your reference
              </p>
              <p
                id='enquiry-ref'
                class='font-mono text-base font-semibold text-primary tracking-wide'>
                ————
              </p>
              <p class='text-xs text-ink-soft mt-2'>
                Keep this reference for your records.
              </p>
            </div>
          </div>

          <!-- Form -->
          <form
            id='enquiry-form'
            class='bg-white border border-line p-6 md:p-10 space-y-6'
            name='giving-enquiry'
            method='POST'
            action='/api/enquiry'
            novalidate>
            <p class='hidden' aria-hidden='true'>
              <label
                >Don&rsquo;t fill this out: <input name='bot-field' /></label
              >
            </p>

            <div>
              <label
                for='name'
                class='block text-[11px] font-bold uppercase tracking-[0.18em] text-ink-soft mb-3'>
                Your name
              </label>
              <input
                type='text'
                id='name'
                name='name'
                required
                autocomplete='name'
                class='w-full border-0 border-b border-line bg-transparent px-0 py-2.5 text-base text-ink focus:border-primary focus:ring-0 outline-none transition-colors'
              />
            </div>

            <div>
              <label
                for='email'
                class='block text-[11px] font-bold uppercase tracking-[0.18em] text-ink-soft mb-3'>
                Email
              </label>
              <input
                type='email'
                id='email'
                name='email'
                required
                autocomplete='email'
                class='w-full border-0 border-b border-line bg-transparent px-0 py-2.5 text-base text-ink focus:border-primary focus:ring-0 outline-none transition-colors'
              />
            </div>

            <div>
              <label
                for='phone'
                class='block text-[11px] font-bold uppercase tracking-[0.18em] text-ink-soft mb-3'>
                Phone <span
                  class='normal-case tracking-normal font-normal text-ink-soft/70'
                  >(optional)</span
                >
              </label>
              <input
                type='tel'
                id='phone'
                name='phone'
                autocomplete='tel'
                class='w-full border-0 border-b border-line bg-transparent px-0 py-2.5 text-base text-ink focus:border-primary focus:ring-0 outline-none transition-colors'
              />
            </div>

            <div>
              <label
                for='topic'
                class='block text-[11px] font-bold uppercase tracking-[0.18em] text-ink-soft mb-3'>
                What is this about?
              </label>
              <select
                id='topic'
                name='topic'
                required
                class='w-full border-0 border-b border-line bg-transparent px-0 py-2.5 text-base text-ink focus:border-primary focus:ring-0 outline-none transition-colors'>
                <option value=''>Choose one</option>
                {topics.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>

            <div>
              <label
                for='message'
                class='block text-[11px] font-bold uppercase tracking-[0.18em] text-ink-soft mb-3'>
                Message
              </label>
              <textarea
                id='message'
                name='message'
                rows='6'
                required
                class='w-full border-0 border-b border-line bg-transparent px-0 py-2.5 text-base text-ink focus:border-primary focus:ring-0 outline-none transition-colors resize-y'
              ></textarea>
            </div>

            <label
              class='flex items-start gap-3 text-xs text-ink-soft leading-relaxed'>
              <input type='checkbox' name='consent' required class='mt-0.5' />
              <span>
                I agree to SPMH processing my details to respond to this
                enquiry, as described in the 
                <a
                  href='/privacy'
                  class='text-primary underline underline-offset-2'
                  >Privacy Policy</a
                >.
              </span>
            </label>

            <!-- Error panel -->
            <div
              id='enquiry-error'
              hidden
              class='border-l-2 border-accent bg-accent/5 px-4 py-3'>
              <p class='text-sm text-ink leading-relaxed'>
                <strong>Something went wrong.</strong> Your message didn&rsquo;t reach
                us. Please try again, or email
                <a
                  href={`mailto:${site.givingEmail}`}
                  class='text-primary font-semibold underline underline-offset-2'>
                  {site.givingEmail}
                </a> directly.
              </p>
            </div>

            <button
              type='submit'
              id='enquiry-submit'
              class='btn-primary w-full !py-3.5 disabled:opacity-60 disabled:cursor-not-allowed'>
              <span id='enquiry-submit-label'>Send enquiry</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- SMALL CTA -->
  <section class='bg-white py-16 md:py-20'>
    <div class='container-prose'>
      <div class='grid lg:grid-cols-12 gap-8 items-center'>
        <div class='lg:col-span-8'>
          <p class='eyebrow-gold mb-4'>Prefer to give now?</p>
          <h2
            class='font-display text-2xl md:text-3xl font-medium text-ink leading-tight text-balance'
            style='letter-spacing: -0.02em;'>
            M-Pesa and bank transfer are available today.
          </h2>
        </div>
        <div class='lg:col-span-4 lg:text-right'>
          <a href='/donate' class='btn-primary'>Go to donate</a>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>

<script>
  const form = document.getElementById(
    'enquiry-form',
  ) as HTMLFormElement | null;
  const button = document.getElementById(
    'enquiry-submit',
  ) as HTMLButtonElement | null;
  const buttonLabel = document.getElementById('enquiry-submit-label');
  const successPanel = document.getElementById('enquiry-success');
  const errorPanel = document.getElementById('enquiry-error');
  const refEl = document.getElementById('enquiry-ref');

  if (form && button && buttonLabel && successPanel && errorPanel && refEl) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Clear previous error
      errorPanel.hidden = true;

      // Loading state
      button.disabled = true;
      const original = buttonLabel.textContent;
      buttonLabel.textContent = 'Sending\u2026';

      try {
        const data = new FormData(form);
        const res = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });

        const json = await res.json().catch(() => ({}));

        if (res.ok && json.ok) {
          // Show success panel with reference
          form.hidden = true;
          refEl.textContent =
            (json.enquiryId || '').slice(0, 8).toUpperCase() || '—';
          successPanel.hidden = false;
          successPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          errorPanel.hidden = false;
          button.disabled = false;
          buttonLabel.textContent = original;
        }
      } catch (err) {
        console.error(err);
        errorPanel.hidden = false;
        button.disabled = false;
        buttonLabel.textContent = original;
      }
    });
  }
</script>
