---
import { formatKes, type Campaign } from '../../data/campaigns';

interface Props {
  campaign: Campaign;
}
const { campaign: c } = Astro.props;
const pct =
  c.target > 0 ? Math.min(100, Math.round((c.raised / c.target) * 100)) : 0;
const showProgress = c.raised > 0;
---

<a
  href={`/campaigns/${c.slug}`}
  class='group flex flex-col bg-white border border-line hover:shadow-[0_20px_40px_-20px_rgba(15,23,32,0.15)] transition-shadow overflow-hidden'>
  <div
    class='aspect-[4/3] bg-gradient-to-br from-secondary to-primary overflow-hidden'>
    <img
      src={c.image}
      alt={c.imageAlt}
      class='w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700'
      loading='lazy'
    />
  </div>

  <div class='p-6 flex-1 flex flex-col'>
    <span
      class:list={[
        'inline-block self-start text-[10px] font-bold uppercase tracking-[0.18em] mb-4',
        c.status === 'active' && 'text-accent',
        c.status === 'planning' && 'text-ink-soft',
        c.status === 'completed' && 'text-green-700',
      ]}>
      {c.status === 'active' && '● Fundraising'}
      {c.status === 'planning' && '○ Coming soon'}
      {c.status === 'completed' && '✓ Completed'}
    </span>

    <h3 class='font-display text-lg font-semibold mb-3 leading-tight text-ink'>
      {c.name}
    </h3>

    <p class='text-sm text-ink-soft leading-relaxed mb-5 flex-1 text-pretty'>
      {c.summary}
    </p>

    {
      showProgress ? (
        <div>
          <div class='w-full h-1 bg-sand overflow-hidden mb-2'>
            <div class='h-full bg-primary' style={`width: ${pct}%`} />
          </div>
          <p class='text-xs text-ink-soft font-mono'>
            {pct}% &middot; {formatKes(c.raised)} of {formatKes(c.target)}
          </p>
        </div>
      ) : (
        <p class='text-xs text-ink-soft font-mono'>
          Goal &middot;{' '}
          <span class='text-ink font-semibold'>{formatKes(c.target)}</span>
        </p>
      )
    }
  </div>
</a>
