---
import { formatKes, type Campaign } from '../../data/campaigns';

interface Props {
  campaign: Campaign;
}
const { campaign: c } = Astro.props;
const pct =
  c.target > 0 ? Math.min(100, Math.round((c.raised / c.target) * 100)) : 0;
const showProgress = c.raised > 0;
---

<a
  href={`/campaigns/${c.slug}`}
  class='group block bg-white border border-line overflow-hidden hover:shadow-[0_30px_60px_-30px_rgba(15,23,32,0.18)] transition-shadow'>
  <div class='grid md:grid-cols-12'>
    <!-- Image -->
    <div
      class='md:col-span-7 aspect-[4/3] md:aspect-auto md:min-h-[420px] bg-gradient-to-br from-secondary to-primary overflow-hidden'>
      <img
        src={c.image}
        alt={c.imageAlt}
        class='w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-[1200ms] ease-out'
        loading='lazy'
      />
    </div>

    <!-- Content -->
    <div
      class='md:col-span-5 p-8 md:p-10 lg:p-12 flex flex-col justify-between'>
      <div>
        <span
          class='inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.18em] text-accent mb-6'>
          <span class='w-1.5 h-1.5 bg-accent rounded-full'></span>
          Most urgent need
        </span>

        <h3 class='display text-2xl md:text-3xl mb-5 text-balance'>
          {c.name}
        </h3>

        <p class='text-base text-ink-soft leading-relaxed mb-6 text-pretty'>
          {c.summary}
        </p>
      </div>

      <div>
        {
          showProgress ? (
            <>
              <div class='flex items-baseline justify-between mb-3'>
                <span class='text-xs font-semibold text-ink-soft uppercase tracking-wider'>
                  Funded
                </span>
                <span class='font-mono text-lg font-semibold text-primary'>
                  {pct}%
                </span>
              </div>
              <div class='w-full h-1 bg-sand overflow-hidden mb-3'>
                <div class='h-full bg-primary' style={`width: ${pct}%`} />
              </div>
              <p class='text-xs text-ink-soft font-mono'>
                {formatKes(c.raised)} of {formatKes(c.target)}
              </p>
            </>
          ) : (
            <div class='pt-6 border-t border-line'>
              <p class='text-xs font-semibold text-ink-soft uppercase tracking-wider mb-2'>
                Goal
              </p>
              <p class='font-mono text-2xl font-semibold text-ink'>
                {formatKes(c.target)}
              </p>
            </div>
          )
        }

        <div
          class='mt-8 inline-flex items-center gap-3 text-primary font-semibold group-hover:gap-4 transition-all'>
          Fund this campaign
          <span aria-hidden='true'>→</span>
        </div>
      </div>
    </div>
  </div>
</a>
